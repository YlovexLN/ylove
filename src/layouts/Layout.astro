---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "YLOVEXLN", description = "YLOVEXLN 的个人主页与作品集" } = Astro.props;
---

<!DOCTYPE html>
<!-- 站点内容为中文：默认语言标识固定为 zh-CN（无 JS 时同样生效） -->
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!--
      语言标识自动匹配：读取浏览器语言列表，命中中文标签时把 <html lang>
      精确为该变体（如 zh-Hant / zh-TW / zh-HK）；非中文浏览器保持默认 zh-CN，
      因为页面内容始终是中文。使用 is:inline 保证在首次渲染前同步执行。
    -->
    <script is:inline>
      (() => {
        const languages =
          navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language];
        const matched = languages.find(
          (lang) => typeof lang === "string" && /^zh\b/i.test(lang)
        );
        if (!matched) return;
        // 统一为 BCP-47 写法（zh_Hant → zh-Hant）
        const normalized = matched.replace(/_/g, "-");
        if (normalized.toLowerCase() !== "zh-cn") {
          document.documentElement.lang = normalized;
        }
      })();
    </script>
    <!-- 字体：寒蝉全圆体（CDN 分片按需加载，字重 400/700）。
         直接在 head 引入，与主样式表并行请求；若放在 global.css 里用 @import，
         会形成 HTML → 主 CSS → 字体 CSS → 字体分片 的串行链路，拖慢首屏文字渲染 -->
    <link rel="preconnect" href="https://fontsapi.zeoseven.com" crossorigin />
    <link rel="stylesheet" href="https://fontsapi.zeoseven.com/3/main/result.css" />
    <link rel="stylesheet" href="https://fontsapi.zeoseven.com/3/bold/result.css" />
  </head>
  <body>
    <slot />
  </body>
</html>
