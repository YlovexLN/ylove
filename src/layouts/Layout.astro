---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Ylove | Developer Portfolio", description = "Personal homepage and portfolio of Ylove - Full-Stack Developer" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- 预加载字体：避免 font-display:swap 期间先显示浏览器系统字体 -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ChillRoundFRegular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ChillRoundFBold.woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
